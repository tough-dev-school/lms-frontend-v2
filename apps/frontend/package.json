{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vitest --config ./tests/unit.config.ts",
    "test:unit:coverage": "vitest --coverage --config ./tests/unit.config.ts",
    "test:regression": "vitest --config ./tests/regression.config.ts",
    "test:regression:update": "vitest --update --config ./tests/regression.config.ts",
    "test:types": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "test:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "test": "run-p fix:*",
    "fix": "run-p fix:*",
    "storybook": "storybook dev -p 3001",
    "storybook:build": "storybook build",
    "storybook:serve": "vite preview --outDir storybook-static --port 3001 --strictPort",
    "api:generate": "kubb generate; tsx patch-api.ts",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@brachkow/email-providers": "^1.4.0",
    "@brachkow/hono-inertia": "^3.1.0",
    "@formkit/auto-animate": "^0.10.0",
    "@hono/node-server": "^2.1.5",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/vue3": "^3.9.1",
    "@sentry/vue": "^11.9.0",
    "@tabler/icons-vue": "^3.49.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/static-renderer": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.0",
    "glightbox": "^3.3.1",
    "hono": "^4.13.14",
    "marked": "^18.1.1",
    "minidenticons": "^4.2.1",
    "vue": "^3.5.44",
    "vue-avatar-cropper": "^6.1.1",
    "vue-i18n": "^11.4.16",
    "vue-notion": "workspace:*"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.51.0",
    "@brachkow/vitest-image-snapshot": "^0.3.0",
    "@faker-js/faker": "^10.6.0",
    "@hono/vite-dev-server": "^0.26.1",
    "@inertiajs/vite": "^3.9.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/message-compiler": "11.4.16",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@kubb/cli": "^4.39.3",
    "@kubb/core": "^4.39.3",
    "@kubb/plugin-client": "^4.39.3",
    "@kubb/plugin-faker": "^4.39.3",
    "@kubb/plugin-oas": "^4.39.3",
    "@kubb/plugin-ts": "^4.39.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-fans": "^1.11.0",
    "jsdom": "^30.1.3",
    "jsonc-eslint-parser": "^3.3.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
