{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "tests/**/*",
    "vue-avatar-cropper.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // Server code shares the folder with the client and uses node:fs and process
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
